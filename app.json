{
  "expo": {
    "name": "pointex-app",
    "slug": "pointex-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pointex-foreground.png",
        "backgroundColor": "#0B0F1A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.shamerocky.pointexapp"
    },
    "plugins": [
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "style": "light"
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "expo-navigation-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "01c398ec-8873-4c5d-9da4-f0fd4f87514d"
      }
    }
  }
}
